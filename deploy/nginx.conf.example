# Portable Nginx example for the Calendorama HTTP contract.
#
# This file is not ready to install. Materialize these values for the target
# environment before validation:
#
#   __LISTEN__                listen address and port
#   __SERVER_NAME__           host names accepted by this server block
#   __PUBLIC_ROOT__           absolute path to the application's public/ directory
#   __PHP_FASTCGI_UPSTREAM__  FastCGI address or socket selected by the environment
#
# TLS termination, certificates, HTTP-to-HTTPS redirects, logging, service
# management and activation are intentionally outside this example. The
# resulting configuration must still satisfy DEPLOYMENT.md.

map "$uri:$arg_v" $calendorama_cache_control {
    default "";
    "~^/rss\.xml:" "no-cache";
    "~^/(?:style\.css|script\.js):[a-f0-9]{12}$" "public, max-age=31536000, immutable";
    "~^/(?:style\.css|script\.js):" "no-cache";
    "~^/(?:favicon\.ico|flakes\.jpg|wait\.gif|blog/[0-9]+_[0-9]+_(?:thmb|full)(?:_[0-9]+)?\.jpg):" "public, max-age=31536000, immutable";
}

server {
    listen __LISTEN__;
    server_name __SERVER_NAME__;
    root __PUBLIC_ROOT__;
    index index.php;

    add_header Cache-Control $calendorama_cache_control;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location = /index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass __PHP_FASTCGI_UPSTREAM__;
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\. {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }
}
