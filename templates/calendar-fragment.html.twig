<section data-calendar-view data-month="{{ calendar.month }}" data-year="{{ calendar.year }}">
	<table class="calendar" aria-label="{{ calendar.navigation.monthName }} {{ calendar.year }}">
		<tbody>
{% for week in calendar.weeks %}
			<tr>{% for cell in week %}<td class="calendar-cell{% if cell.day is null %} calendar-cell--outside-month{% elseif cell.post is null %} calendar-cell--number{% endif %}"{% if cell.isToday %} aria-current="date"{% endif %}{% if cell.day is null %} aria-hidden="true"{% endif %}>{% if cell.post %}<a class="calendar-post" href="{{ cell.post.fullUrl }}" data-calendar-route="{{ cell.post.route }}" data-tooltip="{{ cell.post.title }}"><img alt="{{ cell.post.title }}" width="90" src="{{ cell.post.thumbnailUrl }}"></a>{% elseif cell.day is not null %}<span>{{ cell.day }}</span>{% endif %}</td>{% endfor %}</tr>
{% endfor %}
		</tbody>
	</table>
	<div class="month-summary"><h2>{{ calendar.navigation.monthName }}&nbsp;&nbsp;</h2><nav class="month-navigation" aria-label="Соседние месяцы"><a href="{{ calendar.navigation.previous.href }}" data-calendar-route="{{ calendar.navigation.previous.href }}" data-tooltip="{{ calendar.navigation.previous.title }}" aria-label="{{ calendar.navigation.previous.title }}">&lt;</a><a href="{{ calendar.navigation.next.href }}" data-calendar-route="{{ calendar.navigation.next.href }}" data-tooltip="{{ calendar.navigation.next.title }}" aria-label="{{ calendar.navigation.next.title }}">&gt;</a></nav></div>
</section>
