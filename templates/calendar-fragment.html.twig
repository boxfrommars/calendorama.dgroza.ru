<section class="calendar-view" data-calendar-view data-month="{{ calendar.month }}" data-year="{{ calendar.year }}">
	<table class="calendar" aria-label="{{ calendar.navigation.monthName }} {{ calendar.year }}">
		<tbody>
{% for week in calendar.weeks %}
			<tr>{% for cell in week %}<td{% if cell.class %} class="{{ cell.class }}"{% endif %}{% if 'today' in cell.class %} aria-current="date"{% endif %}{% if cell.day is null %} aria-hidden="true"{% endif %}>{% if cell.post %}<a class="view_full" href="{{ cell.post.fullUrl }}" data-calendar-route="{{ cell.post.route }}" data-tooltip="{{ cell.post.title }}"><img alt="{{ cell.post.title }}" class="thumb" width="90" src="{{ cell.post.thumbnailUrl }}"></a>{% elseif cell.day is not null %}<span>{{ cell.day }}</span>{% endif %}</td>{% endfor %}</tr>
{% endfor %}
		</tbody>
	</table>
	<h2 class="month-heading">{{ calendar.navigation.monthName }}&nbsp;&nbsp;<span class="month-nav" role="navigation" aria-label="Соседние месяцы"><a href="{{ calendar.navigation.previous.href }}" class="previous" data-calendar-route="{{ calendar.navigation.previous.href }}" data-tooltip="{{ calendar.navigation.previous.title }}" aria-label="{{ calendar.navigation.previous.title }}">&lt;</a><a href="{{ calendar.navigation.next.href }}" class="next" data-calendar-route="{{ calendar.navigation.next.href }}" data-tooltip="{{ calendar.navigation.next.title }}" aria-label="{{ calendar.navigation.next.title }}">&gt;</a></span></h2>
</section>
