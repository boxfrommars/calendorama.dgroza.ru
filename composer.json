{
    "name": "boxfrommars/calendorama",
    "description": "A small file-backed calendar",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-calendar": "*",
        "symfony/clock": "^7.4",
        "symfony/http-foundation": "^7.4",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Calendorama\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calendorama\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "@php -d error_reporting=E_ALL vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
